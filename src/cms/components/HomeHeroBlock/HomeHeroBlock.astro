---
import type { StoryblokBlockComponentProps } from '@storyblok/astro'
import HomeHero from '../../../ui/components/HomeHero/HomeHero.astro'
import type { BlockExtraProps } from '../../storyblok'
import type { HomeHero as HomeHeroModel } from '../../types/gen/components/storyblok-components'
import { backgroundTint, ctaModels, imageModel, sectionId, sectionTheme } from '../../utils/blocks'

type Props = StoryblokBlockComponentProps<HomeHeroModel, BlockExtraProps>

const { block, editable } = Astro.props
const { t } = Astro.locals
const labels = { newTab: t('link.new_tab'), external: t('link.external') }
const ctas = ctaModels(block.ctas, labels)
---

<HomeHero
  title={block.title}
  introduction={block.introduction}
  image={imageModel(block.image)}
  ctas={ctas}
  theme={sectionTheme(block.theme)}
  backgroundImage={imageModel(block.background_image)}
  backgroundTint={backgroundTint(block.background_tint)}
  id={sectionId(block.anchor_id)}
  {...editable}
/>
