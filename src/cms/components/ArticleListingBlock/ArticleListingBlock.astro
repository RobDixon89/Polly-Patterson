---
import type { StoryblokBlockComponentProps } from '@storyblok/astro'
import ArticleListing from '../../../ui/components/ArticleListing/ArticleListing.astro'
import InnerHero from '../../../ui/components/InnerHero/InnerHero.astro'
import type { BlockExtraProps } from '../../storyblok'
import type { ArticleListing as ArticleListingModel } from '../../types/gen/components/storyblok-components'
import { ctaModels, imageModel } from '../../utils/blocks'
import { articleCard, listArticles } from '../../utils/stories'

// The article listing: an inner hero from its own fields, then the articles in its folder, newest first, a page at
// a time (`?page=2`).
type Props = StoryblokBlockComponentProps<ArticleListingModel, BlockExtraProps>

const { block, editable, url } = Astro.props
const { t, version } = Astro.locals

// The listing is its folder's start page, so its path is the folder
const folder = url.pathname.replace(/^\/|\/$/g, '')
const page = Math.max(1, Number.parseInt(url.searchParams.get('page') ?? '1', 10) || 1)
const { articles, pages } = await listArticles(folder, page, version)
const numbers = Array.from({ length: pages }, (_, index) => index + 1)

// Keeps the other query parameters, so paging works in the Visual Editor too
const pageHref = (number: number) => {
  const target = new URL(url)
  if (number > 1) target.searchParams.set('page', String(number))
  else target.searchParams.delete('page')
  return `${target.pathname}${target.search}`
}

const externalLabel = t('article.external_label')
const cards = articles.map((story) => ({ key: story.uuid, ...articleCard(story), externalLabel }))
---

<div {...editable}>
  <InnerHero
    title={block.title}
    introduction={block.introduction}
    ctas={ctaModels(block.ctas, { newTab: t('link.new_tab'), external: t('link.external') })}
    backgroundImage={imageModel(block.image)}
    theme="dark"
  />
  <ArticleListing
    articles={cards}
    emptyLabel={t('article.empty')}
    page={page}
    hrefs={numbers.map(pageHref)}
    pageLabels={numbers.map((number) => t('pagination.page', { page: number, pages }))}
    label={t('pagination.label')}
    previousLabel={t('pagination.previous')}
    nextLabel={t('pagination.next')}
  />
</div>
