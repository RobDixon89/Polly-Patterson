---
import type { StoryblokRichtext } from '../../../cms/types/gen/storyblok'
import type { CtaModel, ImageModel, SectionTheme } from '../../types'
import ArticleTag from '../ArticleTag/ArticleTag.astro'
import Button from '../Button/Button.astro'
import RichText from '../RichText/RichText.astro'
import SectionWrapper from '../SectionWrapper/SectionWrapper.astro'

// The inner pages' banner: the page title over an optional background image (SectionWrapper's, tinted for contrast).
// Used by the Inner Hero block and, with the story's own fields, the article listing and articles.
type Props = {
  title: string
  /** Rich text introduction (the Inner Hero block) */
  introduction?: StoryblokRichtext
  /** Plain text introduction (article listing and article descriptions) */
  description?: string
  /** A short line above the title, e.g. an article's date */
  eyebrow?: string
  /** Resource tag, shown alongside the eyebrow */
  tag?: string;
  /** Up to two CTAs under the introduction */
  ctas?: CtaModel[]
  backgroundImage?: ImageModel
  theme?: SectionTheme
  id?: string
  [attr: string]: unknown
}

const { title, introduction, description, eyebrow, tag, ctas = [], backgroundImage, theme, id, ...attrs } = Astro.props
---

<SectionWrapper as="header" id={id} theme={theme} layout="full-width" backgroundImage={backgroundImage} eager class="hero" {...attrs}>
  <div class="site-wide body">
    {eyebrow || tag ? (
      <div class="eyebrow-tag">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {tag && <ArticleTag tag={tag} />}
      </div>
    ) : null}
    <h1>{title}</h1>
    <RichText document={introduction} class="introduction" />
    {description && <p class="introduction">{description}</p>}
    {
      ctas.length > 0 && (
        <div class="ctas">
          {ctas.slice(0, 2).map((cta) => (
            <Button variant={cta.variant} href={cta.href} target={cta.target} externalLabel={cta.externalLabel}>
              {cta.text}
            </Button>
          ))}
        </div>
      )
    }
  </div>
</SectionWrapper>

<style lang="scss">
  @use '@styles/functions/fluid' as *;
  @use '@styles/mixins/typography' as *;

  .hero {
    display: grid;
    align-items: end;
    min-block-size: #{fluid(320, 520)};
  }

  .body {
    padding-block: var(--sectionSpacing);

    > :global(*) {
      max-inline-size: 900px;
    }
  }

  .eyebrow-tag {
    @include body-sm;
    display: flex;
    gap: 8px;
    letter-spacing: 0.08em;
    align-items: center;
  }

  .eyebrow {
    transform: translateY(7%);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: #{fluid(24, 32)};
  }

  .hero :global(.introduction) {
    @include body-lg;
    margin-block-start: #{fluid(16, 24)};
  }
</style>
