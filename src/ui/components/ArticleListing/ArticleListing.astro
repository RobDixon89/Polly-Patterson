---
import type { ComponentProps } from 'astro/types'
import ArticleCard from '../ArticleCard/ArticleCard.astro'
import Pagination from '../Pagination/Pagination.astro'
import SectionWrapper from '../SectionWrapper/SectionWrapper.astro'

// The article listing's grid: one page of article cards, then the pagination (`Pagination` props). Shows `emptyLabel`
// when there are no articles.
type Props = ComponentProps<typeof Pagination> & {
  articles: Array<ComponentProps<typeof ArticleCard> & { key: string }>
  emptyLabel: string
}

const { articles, emptyLabel, ...pagination } = Astro.props

const gridLayout = pagination.page === 1 ? 'first' : pagination.page % 2 === 0 ? 'even' : 'odd'
---

<SectionWrapper>
  {
    articles.length ? (
      <ul class="grid" data-layout={gridLayout}>
        {articles.map(({ key, ...card }, i) => (
          <li>
            {i + 1}
            <ArticleCard {...card} feature={gridLayout === 'first' && i === 0} />
          </li>
        ))}
      </ul>
    ) : (
      <p>{emptyLabel}</p>
    )
  }
  <Pagination {...pagination} />
</SectionWrapper>

<style lang="scss">
  @use '@styles/functions/fluid' as *;
  @use '@styles/functions/media' as *;

  .grid {
    --gridGap: #{fluid(16, 24)};

    display: grid;
    gap: var(--gridGap);
    margin: 0 0 #{fluid(32, 48)};
    padding: 0;
    list-style: none;

    @include from($bp-tablet) {
      grid-template-columns: repeat(2, 1fr);

      &[data-layout='first'] {
        li:nth-child(1) {
          grid-column: 1 / -1;
        }
      }
    }

    @include from($bp-tablet-large) {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 0;

      li {
        grid-row: span 4;
        padding-block-end: var(--gridGap);
      }

      &[data-layout='first'] {
        li {
          &:nth-child(1),
          &:nth-child(3),
          &:nth-child(5),
          &:nth-child(6),
          &:nth-child(8) {
            grid-row: span 3;
          }

          &:nth-child(4),
          &:nth-child(9) {
            grid-row: span 2;
          }
        }
      }

      &[data-layout='even'] {
        li {
          &:nth-child(1),
          &:nth-child(3),
          &:nth-child(5),
          &:nth-child(6),
          &:nth-child(8) {
            grid-row: span 3;
          }

          &:nth-child(4),
          &:nth-child(9) {
            grid-row: span 2;
          }
        }
      }
    }
  }

  li {
    display: flex;
  }
</style>
