---
import type { ImageModel } from '../../types'
import ArticleTag from '../ArticleTag/ArticleTag.astro'
import Image from '../Image/Image.astro'

// An article card. The whole card is one link (the title's, stretched over the card). `feature` makes it a wide card
// with the image beside the text from tablet width up (Latest Articles' first article).
type Props = {
  title: string
  description?: string
  /** The article's type tag, e.g. "article" (shown uppercase) */
  type?: string
  href: string
  /** The link goes to another site */
  external?: boolean
  /** Text for screen readers after the title of an external link, e.g. "(opens another site)" */
  externalLabel?: string
  /** The published date, formatted */
  date?: string
  /** The published date as ISO, for `<time datetime>` */
  dateTime?: string
  image?: ImageModel
  feature?: boolean
  /** The title's heading level: 3 inside a section that has its own heading */
  headingLevel?: 2 | 3
}

const { title, description, type, href, external, externalLabel, date, dateTime, image, feature = false, headingLevel = 2 } = Astro.props
const Heading = `h${headingLevel}` as 'h2' | 'h3'
---

<article class:list={['card', feature && 'feature']}>
  {
    image &&
      (feature ? (
        <Image image={image} ratio={[16, 9]} sizes="(min-width: 768px) 60vw, 100vw" minWidth={480} maxWidth={1600} steps={4} class="image" />
      ) : (
        <Image image={image} ratio={[3, 2]} sizes="(min-width: 768px) 33vw, 100vw" minWidth={400} maxWidth={1200} steps={4} class="image" />
      ))
  }
  <div class="body">
    {type && <ArticleTag tag={type} />}
    {date && <time datetime={dateTime} class="date">{date}</time>}
    <Heading class="title">
      <a href={href} rel={external ? 'noopener' : undefined}>
        {title}
        {external && <span class="external" aria-hidden="true">↗</span>}
        {external && externalLabel && <span class="sr-only">{externalLabel}</span>}
      </a>
    </Heading>
    {description && <p class="description">{description}</p>}
  </div>
</article>

<style lang="scss">
  @use '@styles/functions/animate' as *;
  @use '@styles/functions/fluid' as *;
  @use '@styles/functions/media' as *;
  @use '@styles/mixins/typography' as *;

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--borderColour);

    // The card is one link: hovering anywhere on it, or focusing its link from the keyboard, underlines the title
    @media (hover: hover) and (pointer: fine) {
      &:hover .title a {
        text-decoration-color: currentColor;
      }
    }

    &:has(a:focus-visible) {
      outline: 2px solid currentColor;
      outline-offset: 2px;

      .title a {
        text-decoration-color: currentColor;
      }
    }
  }

  .card :global(.image) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
  }

  // The feature card: image (60%) beside the text from tablet width up, a larger title
  .feature {
    @include from($bp-tablet) {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }

    :global(.image) {
      aspect-ratio: 16 / 9;
      block-size: 100%;
      object-fit: cover;
    }

    .title {
      @include h3;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: #{fluid(8, 12)};
    padding: #{fluid(16, 24)};
  }

  .date {
    @include body-sm;
    order: -1;
    color: var(--mutedColour);
  }

  // Above the date, like the inner hero's eyebrow
  .type {
    @include body-xs;
    order: -2;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .title {
    @include h5;

    a {
      @include transition(text-decoration-color, 0.2s);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
      text-decoration-color: transparent;

      // The link covers the card
      &::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      &:focus-visible {
        outline: none;
      }
    }
  }

  .external {
    font-family: system-ui, sans-serif;
    font-size: 0.6em;
    vertical-align: super;
  }

  .description {
    @include body;
  }
</style>
