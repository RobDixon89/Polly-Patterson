---
import { Device, from } from '../../../cms/utils/media'
import type { ImageModel } from '../../types'
import ArticleTag from '../ArticleTag/ArticleTag.astro'
import ExternalIcon from '../ExternalIcon/ExternalIcon.astro'
import Image from '../Image/Image.astro'

// An article card. The whole card is one link (the title's, stretched over the card). `feature` makes it a wide card
// with the image beside the text from tablet width up (Latest Articles' first article).
type Props = {
  title: string
  description?: string
  /** The article's type tag, e.g. "article" (shown uppercase) */
  type?: string
  href: string
  /** The link goes to another site */
  external?: boolean
  /** Text for screen readers after the title of an external link, e.g. "(opens another site)" */
  externalLabel?: string
  /** The published date, formatted */
  date?: string
  /** The published date as ISO, for `<time datetime>` */
  dateTime?: string
  image?: ImageModel
  feature?: boolean
  /** The title's heading level: 3 inside a section that has its own heading */
  headingLevel?: 2 | 3
}

const {
  title,
  description,
  type,
  href,
  external,
  externalLabel,
  date,
  dateTime,
  image,
  feature = false,
  headingLevel = 2,
} = Astro.props
const Heading = `h${headingLevel}` as 'h2' | 'h3'
---

<article class:list={['card', feature && 'feature']}>
  {
    image &&
      (feature ? (
        <Image
          image={image}
          ratio={[16, 9]}
          sizes={`${from(Device.Tablet)} 60vw, 100vw`}
          minWidth={480}
          maxWidth={1600}
          steps={4}
          class="image"
        />
      ) : (
        <Image
          image={image}
          ratio={[3, 2]}
          sizes={`${from(Device.Tablet)} 33vw, 100vw`}
          minWidth={400}
          maxWidth={1200}
          steps={4}
          class="image"
        />
      ))
  }
  <a href={href} rel={external ? 'noopener' : undefined}>
    {
      date && (
        <time datetime={dateTime} class="date">
          <span>{date}</span>
        </time>
      )
    }

    <Heading class="title">
      {title}
    </Heading>
    {description && <p class="description">{description}</p>}

    {
      external && (
        <span class="external">
          <ExternalIcon />
          {externalLabel && <span class="sr-only">{externalLabel}</span>}
        </span>
      )
    }
    {type && <ArticleTag tag={type} />}
  </a>
</article>

<style lang="scss">
  @use '@styles/functions/animate' as *;
  @use '@styles/functions/fluid' as *;
  @use '@styles/functions/media' as *;
  @use '@styles/mixins/typography' as *;
  @use '@styles/fonts/font-variables' as *;

  .card {
    --acPadding: #{fluid(8, 12)};

    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-rows: min-content 1fr min-content min-content;
    inline-size: 100%;

    a {
      text-decoration: none;
      grid-area: 1 / 1 / -1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      inline-size: 100%;
      block-size: 100%;
      padding: var(--acPadding);

      @include hover-focus {
        .title {
          @include h5;
        }

        @include from($bp-tablet-large) {
          .date {
            opacity: 1;
          }
        }

        :global(.arrow) {
          transform: translate(3px, -3px);
        }
      }
    }

    &:has(a:focus-visible) {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }
  }

  .card :global(.image) {
    grid-row: 1 / span 3;
    grid-column: 1 / -1;
    inline-size: 100%;
    block-size: 100%;
    border-radius: calc(var(--imageBorderRadius) * var(--radiusMultiplier, 1));
    aspect-ratio: var(--acRatio, 5 / 4);
  }

  // Row cards: the image fills the card's height instead of setting it, so cards in a row match and stay short
  .card:not(.feature) :global(.image) {
    @include from($bp-tablet-small) {
      block-size: 100%;
      contain: size;
    }
  }

  .feature {
    @include from($bp-tablet) {
      --acPadding: #{fluid(12, 16)};
      --acRatio: 8 / 3;
      --dateMargin: #{fluid(4, 6)};
      --radiusMultiplier: 1.25;
      --radiusMultiplierBody: 1;
      --titlePadding: #{fluid(16, 24)};

      .title {
        @include h5;
      }

      .description {
        @include body;
      }

      a {
        @include hover-focus {
          .title {
            @include h4;
          }
        }
      }
    }
  }

  .external,
  .date,
  .card :global(.tag) {
    background-color: color-mix(in srgb, var(--fgColour) 85%, transparent);
  }

  .external,
  .date {
    color: var(--bgColour);
    padding: 0.2rem 0.35rem;
    border-radius: 3px;
  }

  .card :global(.tag) {
    grid-row: 1;
    grid-column: 2;
    margin-block-end: auto;
    margin-inline-start: auto;
  }

  .card:not(.feature) :global(.tag) {
    @include body-sm;
  }

  .external {
    display: inline-flex;
    align-items: center;
    margin-inline-start: 6px;
    grid-column: 3;

    svg {
      inline-size: 1em;
      block-size: 1em;
    }
  }

  .date {
    @include body-sm;
    @include transition('opacity', 0.5s);

    grid-row: 2;
    padding-block-end: 0;
    margin-block: auto var(--dateMargin, 4px);
    font-weight: $font-weight-medium;
    margin-inline-end: auto;

    :global(span) {
      display: inline-block;
      transform: translateY(3%);
    }

    @include from($bp-tablet-large) {
      opacity: 0;
    }
  }

  .title {
    @include h6;
    @include transition('font-size', 0.5s);

    padding: var(--titlePadding, fluid(12, 16));
    background-color: var(--bgColour);
    grid-row: 3;
    grid-column: 1 / -1;
    border-radius: calc(var(--imageBorderRadius) * var(--radiusMultiplierBody, 0.85));
    margin-block: auto var(--acPadding);
    margin-inline-end: auto;
  }

  .description {
    @include body-sm;

    line-height: 1.2;
    color: var(--fgColour);
    grid-column: 1 / -1;
    grid-row: 4;
    margin-inline: calc(var(--acPadding) * -1);
    margin-block-start: calc(var(--acPadding) * 0.75);
  }
</style>
