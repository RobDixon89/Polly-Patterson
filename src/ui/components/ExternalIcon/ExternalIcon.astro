---
// The "opens another site" arrow-out-of-box icon. Decorative: pair it with screen reader text where needed. The arrow
// is its own path (`.arrow`) so a parent's hover can move it, e.g. `:global(.arrow) { transform: translate(2px, -2px) }`.
type Props = { class?: string }

const { class: className } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="18"
  height="18"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M10 4.5H7A2.5 2.5 0 0 0 4.5 7v10A2.5 2.5 0 0 0 7 19.5h10a2.5 2.5 0 0 0 2.5-2.5v-3" />
  <path class="arrow" d="M13 11l6.5-6.5M14 4.5h5.5V10" />
</svg>

<style lang="scss">
  @use '@styles/functions/animate' as *;

  .arrow {
    @include transition('transform', 0.3s);
  }
</style>
