---
import type { LinkModel } from '../../types'

// The site footer: a link list, the social links and the copyright line.
export type SocialNetwork = 'twitter' | 'instagram' | 'youtube' | 'substack' | 'bluesky'

type Props = {
  links: LinkModel[]
  /** Each network's address and accessible name (say it opens in a new tab: they all do); networks without an address are left out */
  social: Array<{ network: SocialNetwork; href: string; label: string }>
  copyright?: string
  navLabel: string
  socialLabel: string
  [attr: string]: unknown
}

const { links, social, copyright, navLabel, socialLabel, ...attrs } = Astro.props

// The icons, drawn in the text colour: line icons on a 24px grid, or filled brand marks on their own grid
type Icon = { path: string; viewBox?: string; filled?: boolean }
const PATHS: Record<SocialNetwork, string> = {
  twitter: 'M178.57 127.15 290.27 0h-26.46l-97.03 110.38L89.34 0H0l117.13 166.93L0 300.25h26.46l102.4-116.59 81.8 116.59h89.34M36.01 19.54H76.66l187.13 262.13h-40.66',
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8zM17.5 6.5h.01',
  youtube: 'M3 8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zM10 9v6l5-3z',
  substack: 'M0 0h448v62.804H0V0zm0 229.083h448v282.388L223.954 385.808 0 511.471V229.083zm0-114.542h448v62.804H0v-62.804z',
  bluesky: 'm135.72 44.03c66.496 49.921 138.02 151.14 164.28 205.46 26.262-54.316 97.782-155.54 164.28-205.46 47.98-36.021 125.72-63.892 125.72 24.795 0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-0.0174-2.9357-1.1937 0.51669-3.7077 7.8964-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07 0-88.687 77.742-60.816 125.72-24.795z'
}
const ICONS: Record<SocialNetwork, Icon> = {
  twitter: { path: PATHS.twitter, viewBox: '0 0 300 300.251', filled: true },
  instagram: { path: PATHS.instagram },
  youtube: { path: PATHS.youtube },
  substack: { path: PATHS.substack, viewBox: '0 0 448 512', filled: true },
  bluesky: { path: PATHS.bluesky, viewBox: '0 0 600 530', filled: true },
}
---

<footer class="footer" data-section-theme="dark" {...attrs}>
  <div class="site-wide inner">
    {
      links.length > 0 && (
        <nav aria-label={navLabel}>
          <ul class="links">
            {links.map((link) => (
              <li>
                <a href={link.href} target={link.target}>{link.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      social.length > 0 && (
        <ul class="social" aria-label={socialLabel}>
          {social.map(({ network, href, label }) => (
            <li>
              <a href={href} aria-label={label} target="_blank" rel="noopener">
                <svg viewBox={ICONS[network].viewBox ?? '0 0 24 24'} width="20" height="20" aria-hidden="true">
                  {ICONS[network].filled ? (
                    <path d={ICONS[network].path} fill="currentColor" />
                  ) : (
                    <path d={ICONS[network].path} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  )}
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {copyright && <p class="copyright">{copyright}</p>}
  </div>
</footer>

<style lang="scss">
  @use '@styles/functions/animate' as *;
  @use '@styles/functions/fluid' as *;
  @use '@styles/functions/media' as *;
  @use '@styles/mixins/content-styles' as *;
  @use '@styles/mixins/typography' as *;

  .footer {
    background-color: var(--bgColour);
    color: var(--fgColour);
  }

  .inner {
    display: grid;
    gap: #{fluid(24, 32)};
    padding-block: #{fluid(40, 64)};
    justify-content: center;
    text-align: center;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links {
    gap: 0.5rem #{fluid(16, 32)};

    a {
      @include underline-on-hover(4px);
    }
  }

  .social {
    gap: 0.5rem;

    a {
      @include circle-fill-hover;
      inline-size: 2.75rem;
      block-size: 2.75rem;
    }
  }

  .copyright {
    @include body-sm;
    color: var(--mutedColour);
  }
</style>
